---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SwitchPill from '../components/SwitchPill.astro';
import grid from '../data/grid-motion.json';
import { collectionNodes } from '../lib/site.js';
import '../styles/grid.css';
import '../styles/motion-list.css';

// Motion as a running order, like the wedding Timeline board: a small mono line
// above each big Extrabold name. Order and media come from grid-motion.json.
// Desktop: hovering a name plays that job's loop in a tilted frame by the cursor.
// Touch: each entry shows its poster under the name.
const projects = await getCollection('projects');
const bySlug = Object.fromEntries(projects.map((p) => [p.id, p.data]));
const items = grid.rows.flatMap((r) => r.cards).map((c) => ({
  slug: c.slug,
  title: c.titleOverride ?? bySlug[c.slug]?.title ?? c.slug,
  sub: c.subOverride ?? bySlug[c.slug]?.subtitle,
  video: c.media.type === 'video' ? '/' + c.media.src : undefined,
  poster: '/' + (c.media.poster ?? c.media.src),
}));
const title = 'Motion — Music Videos & Commercials by Jessi Clover Belgrave';
const description = 'Music videos, commercials and live films directed by Jessi Clover Belgrave for Sam Smith, Audemars Piguet, Gorgon City, Sonny Fodera, Sienna Spiro and more.';
---
<Base title={title} description={description} path="motion" ogImage="images/og/sam-smith.jpg"
      jsonld={collectionNodes({ path: 'motion', title, description })}
      active="motion">
  <h1 class="sr-only">Motion — music videos, commercials &amp; films directed by Jessi Clover Belgrave</h1>
  <div class="mega" aria-hidden="true">Motion</div>
  <ol class="tl">
    {items.map((i) => (
      <li>
        <a class="tl-i" href={'/' + i.slug} data-video={i.video} data-poster={i.poster}>
          {i.sub && <span class="tl-s">{i.sub}</span>}
          <span class="tl-t">{i.title}</span>
          <img class="tl-thumb" src={i.poster} alt="" loading="lazy" />
        </a>
      </li>
    ))}
  </ol>
  <div class="tl-peek" aria-hidden="true"><video muted loop playsinline preload="none"></video></div>
  <SwitchPill active="motion" slot="after-scripts" />
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const peek = document.querySelector<HTMLElement>('.tl-peek');
    const list = document.querySelector('.tl');
    if (!peek || !list || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    const vid = peek.querySelector('video')!;
    let x = 0, y = 0, px = 0, py = 0, raf = 0;
    const place = () => { peek.style.transform = `translate(${px + 36}px, ${py - 120}px) rotate(3deg)`; };
    const tick = () => {
      px += (x - px) * 0.18; py += (y - py) * 0.18; place();
      raf = Math.abs(x - px) + Math.abs(y - py) > 0.5 ? requestAnimationFrame(tick) : 0;
    };
    list.addEventListener('pointermove', (e) => {
      x = (e as PointerEvent).clientX; y = (e as PointerEvent).clientY;
      if (!raf) raf = requestAnimationFrame(tick);
    });
    list.querySelectorAll<HTMLAnchorElement>('.tl-i').forEach((a) => {
      a.addEventListener('pointerenter', (e) => {
        if (!peek.classList.contains('on')) {
          px = x = (e as PointerEvent).clientX; py = y = (e as PointerEvent).clientY; place();
        }
        vid.poster = a.dataset.poster ?? '';
        if (a.dataset.video && vid.getAttribute('src') !== a.dataset.video) vid.src = a.dataset.video;
        vid.play().catch(() => {});
        peek.classList.add('on');
      });
      a.addEventListener('pointerleave', () => { peek.classList.remove('on'); vid.pause(); });
    });
  });
</script>
