<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/assets/logo.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>404 — Jessi Clover Belgrave</title>
  <style is:inline>
    :root { --accent: #186f49; --bg: #ecdcdd; --ink: #171017; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: var(--bg) url('/assets/paper.jpg') center / cover no-repeat fixed; min-height: 100vh;
      font-family: 'ABC Simon Mono', ui-monospace, Menlo, monospace;
      font-weight: 500; color: var(--ink); cursor: url('/assets/cursor.png') 24 8, auto; overflow-x: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    .wrap {
      text-align: center;
      opacity: 0; transform: translateY(12px);
      animation: fadeUp 0.7s ease 0.2s forwards;
    }
    @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
    .wrap img { height: 90px; width: auto; display: block; margin: 0 auto 32px; }
    .wrap p {
      font-size: 11px; font-weight: 500; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--ink); opacity: 0.8;
      margin-bottom: 28px;
    }
    .wrap a {
      font-size: 11px; font-weight: 500; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--ink); text-decoration: none;
      opacity: 0.8; border-bottom: 1px solid rgba(23,16,23,0.35);
      padding-bottom: 2px; transition: opacity 0.2s, color 0.2s, border-color 0.2s;
    }
    .wrap a:hover { opacity: 1; color: var(--accent); border-bottom-color: var(--accent); }
    @media (prefers-reduced-motion: reduce) { .wrap { animation: none; opacity: 1; transform: none; } }
  </style>

  <style is:inline>
    @font-face {
      font-family: 'ABC Simon Mono';
      src: url('/font/ABCSimonMono-Medium.woff2') format('woff2');
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }
  </style>
</head>
<body>

  <div class="wrap">
    <a href="/"><img src="/assets/logo.webp" alt="Jessi Clover Belgrave" width="300" height="239" /></a>
    <p>404 — page not found</p>
    <a href="/">← back home</a>
  </div>
</body>
</html>
