---
import Base from './Base.astro';
import Credits from '../components/Credits.astro';
import Media from '../components/Media.astro';
import { projectNodes } from '../lib/site.js';
import '../styles/player.css';

const { entry } = Astro.props;
const d = entry.data;
const hasInstagram = d.media.some((m) => m.type === 'instagram');
---
<Base title={d.pageTitle} description={d.description} path={entry.id}
      ogTitle={d.ogTitle} ogImage={d.ogImage} ogType="video.other" vimeo
      jsonld={projectNodes(entry.id, d)} active="motion" bodyClass="kind-player">
  <div class="project-wrap">
    <div class="project-meta">
      <h1 class="artist">{d.title}</h1>
      {d.subtitle && <div class="title">{d.subtitle}</div>}
      <Credits credits={d.credits} />
      <a class="backlink" href="/motion">&larr; back</a>
    </div>
    <div class="player-stack">
      {d.media.map((m, i) => <Media item={m} tname={i === 0 ? 'cover-' + entry.id : undefined} />)}
    </div>
  </div>
  {/* embed.js only scans the page once when it first loads; on later client-side
      visits the new blockquotes have to be processed explicitly */}
  {hasInstagram && <script is:inline data-astro-rerun slot="after-scripts" set:html={"(function(){if(window.instgrm&&window.instgrm.Embeds){window.instgrm.Embeds.process();return;}var s=document.createElement('script');s.async=true;s.src='https://www.instagram.com/embed.js';document.body.appendChild(s);})();"}></script>}
</Base>
