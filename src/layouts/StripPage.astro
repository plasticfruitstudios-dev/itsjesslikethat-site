---
import { Picture, getImage } from 'astro:assets';
import Base from './Base.astro';
import Credits from '../components/Credits.astro';
import StripScript from '../components/StripScript.astro';
import { imageFor } from '../lib/images';
import { projectNodes } from '../lib/site.js';
import '../styles/strip.css';
import 'photoswipe/style.css';

const { entry } = Astro.props;
const d = entry.data;

// Pre-render each strip image: responsive Picture for the strip itself and a
// large webp target for the PhotoSwipe lightbox (pinch-zoom, swipe, keyboard).
const items = await Promise.all(d.media.map(async (m) => {
  const meta = imageFor(m.src);
  if (!meta) return { m, meta: null, large: null, lw: 0, lh: 0 };
  const lw = Math.min(2000, meta.width);
  const lh = Math.round(meta.height * (lw / meta.width));
  const large = await getImage({ src: meta, format: 'webp', width: lw });
  const widths = [...new Set([480, 800, 1200, meta.width].filter((w) => w <= meta.width))];
  return { m, meta, large, lw, lh, widths };
}));
---
<Base title={d.pageTitle} description={d.description} path={entry.id}
      ogTitle={d.ogTitle} ogImage={d.ogImage}
      jsonld={projectNodes(entry.id, d)} active="stills" bodyClass="kind-strip">
  <div class="strip-wrap" id="strip">
    <div class="strip-meta">
      <h1 class="artist">{d.title}</h1>
      {d.subtitle && <div class="title">{d.subtitle}</div>}
      <Credits credits={d.credits} />
      <a class="backlink" href="/stills">&larr; back to stills</a>
    </div>
    {items.map(({ m, meta, large, lw, lh, widths }, i) => (
      <div class="strip-img" style={i === 0 ? `view-transition-name: cover-${entry.id}` : undefined}>
        {meta ? (
          <a href={large.src} data-pswp-width={lw} data-pswp-height={lh} data-caption={m.alt} target="_blank" rel="noopener" aria-label={`view ${m.alt} full screen`}>
            <Picture src={meta} formats={['avif', 'webp']} widths={widths} sizes="(max-width: 640px) 92vw, 60vw" loading={m.loading ?? 'lazy'} alt={m.alt} />
          </a>
        ) : (
          <img src={'/' + m.src} loading={m.loading ?? 'lazy'} alt={m.alt} />
        )}
      </div>
    ))}
    <div class="strip-end"></div>
  </div>
  <div class="scroll-hint">scroll &rarr;</div>
  <div class="strip-progress" aria-hidden="true"><span data-strip-bar></span></div>
  <div class="strip-counter" aria-hidden="true"><span data-strip-pos>01</span> / {String(d.media.length).padStart(2, '0')}</div>
  <StripScript slot="after-scripts" />
</Base>
