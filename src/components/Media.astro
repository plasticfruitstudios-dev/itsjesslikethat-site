---
// One player-stack / strip media item. Wrapper class and inline style kept
// verbatim from the legacy markup via frontmatter. Images render through the
// astro:assets pipeline (AVIF/WebP srcset) when a src/assets copy exists.
import { Picture } from 'astro:assets';
import { imageFor } from '../lib/images';

interface Props {
  item: {
    type: 'image' | 'video' | 'iframe' | 'instagram';
    src: string; alt?: string; loading?: 'eager' | 'lazy';
    poster?: string; klass?: string; style?: string; title?: string;
  };
  /** view-transition-name for this item's wrapper (morph target) */
  tname?: string;
}
const { item } = Astro.props;
const klass = item.klass ?? (item.type === 'instagram' ? 'media ig' : 'media');
const isYouTube = item.type === 'iframe' && item.src.includes('youtube');
const meta = item.type === 'image' ? imageFor(item.src) : null;
const pMeta = item.type === 'video' && item.poster ? imageFor(item.poster) : null;
const { tname } = Astro.props;
const wrapStyle = [item.style, tname ? `view-transition-name: ${tname}` : null].filter(Boolean).join(';') || undefined;
const widths = meta ? [...new Set([480, 800, 1200, meta.width].filter((w) => w <= meta.width))] : [];
---
<div class={klass} style={wrapStyle}>
  {item.type === 'image' && (meta
    ? <Picture src={meta} formats={['avif', 'webp']} quality={80} widths={widths} sizes="(max-width: 900px) 92vw, 60vw" loading={item.loading ?? 'lazy'} alt={item.alt} />
    : <img src={'/' + item.src} loading={item.loading ?? 'lazy'} alt={item.alt} />)}
  {item.type === 'video' && <video data-src={'/' + item.src} poster={item.poster ? '/' + item.poster : undefined} style={pMeta ? `aspect-ratio: ${pMeta.width} / ${pMeta.height}` : undefined} loop muted playsinline preload="none"></video>}
  {item.type === 'instagram' && <blockquote class="instagram-media" data-instgrm-permalink={item.src} data-instgrm-version="14" style="margin:0 auto; max-width:540px; width:100%;"></blockquote>}
  {item.type === 'iframe' && (isYouTube
    ? <iframe src={item.src} title={item.title} frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
    : <iframe src={item.src} title={item.title} frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin"></iframe>)}
</div>
