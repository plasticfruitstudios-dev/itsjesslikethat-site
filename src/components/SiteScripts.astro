---
// Every behaviour the legacy site duplicated per page, now existing exactly once.
// Runs via astro:page-load so it re-initialises after client-side view transitions.
---
<script>
  // Loader - 0-100% counter tied to real image loading; first site visit per session only
  function initLoader() {
    const loader = document.getElementById('loader');
    if (!loader) return;
    if (sessionStorage.getItem('jess-visited')) {
      loader.style.display = 'none';
    } else {
      sessionStorage.setItem('jess-visited', '1');
      const pctEl = document.getElementById('load-pct');
      const imgs = Array.from(document.images).filter(im => !loader.contains(im));
      let loadedCount = 0;
      imgs.forEach(im => {
        if (im.complete) loadedCount++;
        else {
          im.addEventListener('load', () => loadedCount++);
          im.addEventListener('error', () => loadedCount++);
        }
      });
      const start = performance.now();
      const MIN = 1000, MAX = 2800;
      let shown = 0;
      function tick(now) {
        const t = now - start;
        const real = imgs.length ? loadedCount / imgs.length : 1;
        const floor = Math.min(t / MAX, 1);
        const ceil = Math.min(t / MIN, 1);
        const target = Math.min(Math.max(real, floor), ceil) * 100;
        shown = Math.min(shown + 3, Math.max(shown, target));
        pctEl.textContent = Math.floor(shown) + '%';
        if (shown >= 100) {
          loader.classList.add('hide');
          setTimeout(() => loader.style.display = 'none', 700);
        } else {
          requestAnimationFrame(tick);
        }
      }
      requestAnimationFrame(tick);
    }
  }

  // lazy-load + keep-alive for local video loops (browsers suspend long muted loops)
  function initVideos() {
    if (window.__pfsVideoCleanup) { window.__pfsVideoCleanup(); window.__pfsVideoCleanup = null; }
    const vids = Array.from(document.querySelectorAll('video[data-src]'));
    if (!vids.length) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return; // posters only
    const start = v => {
      if (v.dataset.src && !v.src) { v.src = v.dataset.src; v.load(); }
      v.play().catch(() => {});
    };
    const preIO = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting && e.target.dataset.src && !e.target.src) {
          e.target.src = e.target.dataset.src; e.target.load(); preIO.unobserve(e.target);
        }
      });
    }, { rootMargin: '600px 0px' });
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        e.target.dataset.vis = e.isIntersecting ? '1' : '0';
        if (e.isIntersecting) start(e.target);
        else e.target.pause();
      });
    }, { threshold: 0.1 });
    vids.forEach(v => { preIO.observe(v); io.observe(v); });
    const iv = setInterval(() => {
      if (document.hidden) return;
      vids.forEach(v => { if (v.dataset.vis === '1' && v.paused) start(v); });
    }, 3000);
    // iOS Low Power Mode rejects non-gesture play(); any touch is a gesture,
    // so use it to kick visible loops that the policy paused.
    const kick = () => vids.forEach(v => { if (v.dataset.vis === '1' && v.paused) start(v); });
    window.addEventListener('touchend', kick, { passive: true });
    window.__pfsVideoCleanup = () => {
      preIO.disconnect(); io.disconnect(); clearInterval(iv);
      window.removeEventListener('touchend', kick);
    };
  }

  // iOS Safari: WebKit's view-transition rendering has proven unreliable on
  // this site (flicker through three transition grammars), so on iOS we skip
  // it entirely and hand-animate the navigation with plain CSS opacity —
  // primitives every engine renders perfectly. Desktop keeps native morphs.
  const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent)
    || (navigator.userAgent.includes('Macintosh') && navigator.maxTouchPoints > 1);
  const noMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  let dissolveShot = null;
  if (isIOS) {
    document.addEventListener('astro:before-swap', (e) => {
      e.viewTransition?.skipTransition();
      if (noMotion()) return;
      // keep a visual copy of the outgoing page: it will dissolve ON TOP of
      // the complete incoming page, so total coverage never dips through
      // white — a true cross-dissolve with no flash frame possible
      const wrap = document.createElement('div');
      wrap.style.cssText = 'position:fixed;inset:0;z-index:99999;pointer-events:none;overflow:hidden;background:#eabcbc';
      // shadow root: the ghost keeps the OLD page's exact styles without
      // leaking them onto the incoming page
      const shadow = wrap.attachShadow({ mode: 'open' });
      document.querySelectorAll('style').forEach((s) => shadow.appendChild(s.cloneNode(true)));
      // freeze entrance animations: a cloned node restarts them from opacity 0,
      // which blinked the outgoing page out before the dissolve began. Grid
      // cards are left alone: their revealed state is the cloned .visible class,
      // so cards the live page hasn't revealed yet stay hidden in the ghost too
      const freeze = document.createElement('style');
      freeze.textContent = '*,*::before,*::after{animation:none!important;transition:none!important}.project-wrap,.strip-wrap,.project-content,.info-content,.info-inner{opacity:1!important;transform:none!important}';
      shadow.appendChild(freeze);
      const inner = document.body.cloneNode(true);
      inner.querySelectorAll('script').forEach((s) => s.remove());
      inner.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
      // media must hold still inside the ghost: a cloned <video> restarts at a
      // different frame and a cloned iframe reloads its whole player, both
      // visible while the ghost is up. Videos become a snapshot of their current
      // frame (or their poster); iframes become a box of the same size that
      // keeps the embed's own card styling (Instagram's white card) or, for the
      // main film player, the player's plate — never a different picture.
      const liveMedia = Array.from(document.body.querySelectorAll('video, iframe'));
      Array.from(inner.querySelectorAll('video, iframe')).forEach((node, i) => {
        const live = liveMedia[i];
        if (!live) return;
        const r = live.getBoundingClientRect();
        const cs = getComputedStyle(live);
        // an iframe the live page keeps invisible (a film player held on its
        // landed picture, a YouTube embed still loading) stays an inert,
        // invisible iframe in the ghost, so what shows behind it (picture,
        // play mark) is unchanged: no src (nothing loads), its URL kept in
        // data-ghost-src for the play-mark rule, no onload that could mark it
        // ready, and opacity pinned at 0
        if (live.tagName === 'IFRAME' && +cs.opacity === 0) {
          node.setAttribute('data-ghost-src', node.getAttribute('src') || '');
          node.removeAttribute('src');
          node.removeAttribute('onload');
          node.style.setProperty('opacity', '0', 'important');
          return;
        }
        const box = 'display:block;position:' + cs.position + ';top:' + cs.top + ';left:' + cs.left
          + ';width:' + r.width + 'px;height:' + r.height + 'px;';
        let still;
        const unplayed = live.tagName === 'VIDEO' && live.paused && live.currentTime === 0;
        if (live.tagName === 'VIDEO' && !unplayed && live.readyState >= 2 && live.videoWidth) {
          still = document.createElement('canvas');
          still.width = live.videoWidth; still.height = live.videoHeight;
          try { still.getContext('2d').drawImage(live, 0, 0); } catch (err) { /* keep blank */ }
        } else if (live.tagName === 'VIDEO' && live.getAttribute('poster')) {
          still = document.createElement('img');
          still.src = live.getAttribute('poster');
          still.style.objectFit = 'cover';
        } else {
          still = document.createElement('div');
        }
        still.className = node.className;
        still.style.cssText += box;
        if (live.tagName === 'IFRAME') {
          const transparent = (c) => c === 'transparent' || c === 'rgba(0, 0, 0, 0)';
          const player = live.closest('.player');
          const plate = player ? getComputedStyle(player).backgroundColor : '';
          // a revealed non-Vimeo (YouTube) main player sits over the picture the
          // page landed on: let that picture show through rather than a flat plate
          const pictured = player && !/player\.vimeo\.com/.test(live.src) && /url\(/.test(player.getAttribute('style') || '');
          still.style.backgroundColor = pictured ? 'transparent'
            : transparent(cs.backgroundColor) ? (plate || 'transparent') : cs.backgroundColor;
          still.style.border = cs.border;
          still.style.borderRadius = cs.borderRadius;
          still.style.boxShadow = cs.boxShadow;
          still.style.margin = cs.margin;
        }
        node.replaceWith(still);
      });
      // the sticky nav has no scroll container inside the ghost: pin it to the
      // top of the viewport the way the live page shows it
      const ghostNav = inner.querySelector('nav');
      if (ghostNav) ghostNav.style.cssText += ';position:relative;top:' + window.scrollY + 'px';
      inner.style.cssText = 'position:absolute;left:0;top:' + (-window.scrollY) + 'px;width:100%;margin:0';
      shadow.appendChild(inner);
      dissolveShot = wrap;
    });
  }

  // Hold navigation until the incoming page's visible imagery is decoded
  // (clones inherit <picture> source selection, so the real AVIF/WebP
  // candidates warm too), so the page arrives in one piece. The work starts
  // the moment a link is hovered, focused or touched (warmFor), so by the time
  // of the click it is usually done; the click itself never waits more than
  // HOLD_MS for it.
  const HOLD_MS = 150;
  const IMAGERY_LIMIT = 6;
  // the hero (first image) decodes on its own first; the rest queue behind it
  // so they can't take its bandwidth on a slow link
  const imageryJobs = (doc, holder, limit) => {
    const jobs = [];
    const decodeEl = (el) => {
      const clone = el.cloneNode(true);
      clone.querySelectorAll('img').forEach((im) => im.setAttribute('loading', 'eager'));
      if (clone.tagName === 'IMG') clone.setAttribute('loading', 'eager');
      holder.appendChild(clone);
      const img = clone.tagName === 'PICTURE' ? clone.querySelector('img') : clone;
      return img && img.decode ? img.decode().catch(() => {}) : Promise.resolve();
    };
    const els = Array.from(doc.querySelectorAll('main picture, main img:not(picture img)')).slice(0, limit);
    if (els.length) {
      const hero = decodeEl(els[0]);
      jobs.push(hero);
      if (els.length > 1) jobs.push(hero.then(() => Promise.all(els.slice(1).map(decodeEl))));
    }
    const seen = new Set();
    doc.querySelectorAll('main video[poster]').forEach((v, i) => {
      if (i >= limit) return;
      const src = v.getAttribute('poster');
      if (!src || seen.has(src)) return;
      seen.add(src);
      const im = new Image();
      holder.appendChild(im);
      im.src = src;
      jobs.push(im.decode().catch(() => {}));
    });
    doc.querySelectorAll('.player[style*="url("]').forEach((el) => {
      const m = /url\(['"]?([^'")]+)/.exec(el.getAttribute('style') || '');
      if (m && !m[1].startsWith('blob:')) { const im = new Image(); holder.appendChild(im); im.src = m[1]; jobs.push(im.decode().catch(() => {})); }
    });
    return jobs;
  };
  // offscreen decode holders live outside <body>: the swap doesn't discard
  // them mid-decode and the iOS ghost doesn't clone them
  const newHolder = () => {
    const holder = document.createElement('div');
    holder.setAttribute('aria-hidden', 'true');
    holder.style.cssText = 'position:absolute;left:-9999px;top:0;width:1px;height:1px;overflow:hidden;pointer-events:none';
    document.documentElement.appendChild(holder);
    return holder;
  };
  const parsePage = (html) => {
    const doc = new DOMParser().parseFromString(html, 'text/html');
    doc.querySelectorAll('noscript').forEach((el) => el.remove());
    return doc;
  };
  // pathname -> { html: Promise<string> (the page, reused by the click),
  //               ready: Promise (its first imagery decoded) }
  const warmed = new Map();
  const warmFor = (a, imagery = true) => {
    if (!a || a.target || a.hasAttribute('download') || a.dataset.astroPrefetch === 'false') return;
    let url;
    try { url = new URL(a.href, location.href); } catch (err) { return; }
    if (url.origin !== location.origin || url.pathname === location.pathname) return;
    let w = warmed.get(url.pathname);
    if (!w) {
      const html = fetch(url.pathname)
        .then((r) => (r.ok && !r.redirected && /text\/html/.test(r.headers.get('content-type') || '') ? r.text() : ''))
        .catch(() => '');
      w = { html, ready: null };
      warmed.set(url.pathname, w);
      setTimeout(() => warmed.delete(url.pathname), 60000);
    }
    if (imagery && !w.ready) {
      w.ready = w.html.then((html) => {
        if (!html) return;
        const holder = newHolder();
        return Promise.all(imageryJobs(parsePage(html), holder, IMAGERY_LIMIT))
          .finally(() => setTimeout(() => holder.remove(), 8000));
      }).catch(() => {});
    }
  };
  let hoverTimer = 0;
  document.addEventListener('pointerover', (e) => {
    if (e.pointerType === 'touch') return; // touch is handled below
    const a = e.target.closest?.('a[href]');
    clearTimeout(hoverTimer);
    // mouse/pen: a short dwell so sweeping across the grid doesn't decode everything
    if (a) hoverTimer = setTimeout(() => warmFor(a), 80);
  }, { passive: true });
  // touch: fetch the page only (a touch may be the start of a scroll, so no
  // image downloads here); the click decodes imagery within HOLD_MS
  document.addEventListener('touchstart', (e) => warmFor(e.target.closest?.('a[href]'), false), { passive: true });
  let focusTimer = 0;
  document.addEventListener('focusin', (e) => {
    clearTimeout(focusTimer);
    const a = e.target.closest?.('a[href]');
    if (a) focusTimer = setTimeout(() => warmFor(a), 150);
  });

  // Astro pairs persisted elements by id with querySelector (first match); a
  // page showing the same loop twice would break the swap — keep the first
  const dedupePersist = (root) => {
    const ids = new Set();
    root.querySelectorAll('[data-astro-transition-persist]').forEach((el) => {
      const id = el.getAttribute('data-astro-transition-persist');
      if (ids.has(id)) el.removeAttribute('data-astro-transition-persist');
      else ids.add(id);
    });
  };
  dedupePersist(document);

  // Only covers visible on BOTH pages morph. Every other named cover would get
  // its own view-transition group: it leaves a hole in the page snapshot and
  // fades in or out on its own over the background (the white wash going back
  // home), or flies off-screen toward a card below the fold. Unpaired covers
  // are un-named for the transition so they cross-fade with the page instead.
  const suppressed = [];
  const suppressName = (el) => {
    suppressed.push([el, el.style.getPropertyValue('view-transition-name'), el.style.getPropertyPriority('view-transition-name')]);
    el.style.setProperty('view-transition-name', 'none', 'important');
  };
  const restoreNames = () => {
    suppressed.splice(0).forEach(([el, value, priority]) => {
      if (value) el.style.setProperty('view-transition-name', value, priority);
      else el.style.removeProperty('view-transition-name');
    });
  };
  const inView = (el) => {
    const r = el.getBoundingClientRect();
    if (!r.width || !r.height) return false;
    const w = Math.min(r.right, innerWidth) - Math.max(r.left, 0);
    const h = Math.min(r.bottom, innerHeight) - Math.max(r.top, 0);
    return w > 0 && h > 0 && (w * h) / (r.width * r.height) >= 0.2;
  };
  const namedCovers = (root) => Array.from(root.querySelectorAll('[data-astro-transition-scope], [style*="view-transition-name"]'))
    .map((el) => [el, getComputedStyle(el).viewTransitionName])
    .filter(([, name]) => name && name.startsWith('cover-'));
  // cover names the incoming page will carry (read from its markup, not yet rendered)
  const coverNamesIn = (doc) => {
    const byScope = new Map();
    doc.querySelectorAll('style').forEach((st) => {
      for (const m of st.textContent.matchAll(/\[data-astro-transition-scope="([^"]+)"\]\s*\{\s*view-transition-name:\s*([\w-]+)/g)) byScope.set(m[1], m[2]);
    });
    const names = new Set();
    doc.body.querySelectorAll('[data-astro-transition-scope]').forEach((el) => {
      const n = byScope.get(el.getAttribute('data-astro-transition-scope'));
      if (n) names.add(n);
    });
    doc.body.querySelectorAll('[style*="view-transition-name"]').forEach((el) => {
      const m = /view-transition-name:\s*([\w-]+)/.exec(el.getAttribute('style') || '');
      if (m) names.add(m[1]);
    });
    return names;
  };
  let keptNames = null;
  // Where each page's covers sit (document coordinates, per viewport width),
  // saved as the page is left, so the OLD page — captured before the new one
  // renders — can tell whether a card will actually be on screen at the
  // destination. A picture kept named but unmatched on arrival fades alone
  // over a hole in the snapshot.
  const LAYOUT_KEY = 'cover-layout';
  const readLayouts = () => { try { return JSON.parse(sessionStorage.getItem(LAYOUT_KEY) || '{}'); } catch (err) { return {}; } };
  const saveLayout = (path, covers) => {
    const rects = {};
    covers.forEach(([el, name]) => {
      const r = el.getBoundingClientRect();
      if (r.width && r.height) rects[name] = [r.left, r.top + scrollY, r.width, r.height];
    });
    // nothing measured (e.g. left through the open mobile menu, which un-names
    // every cover): keep what was saved before
    if (!Object.keys(rects).length) return;
    const all = readLayouts();
    all[path] = { w: innerWidth, rects };
    try { sessionStorage.setItem(LAYOUT_KEY, JSON.stringify(all)); } catch (err) { /* private mode */ }
  };
  // will `name` be on screen when `doc` arrives at `path`?
  const willBeInView = (doc, path, name, traverse) => {
    const layout = readLayouts()[path];
    // not seen at this width: a project page's hero sits in the first screen;
    // a grid is unknown, so cross-fade rather than risk a lone fading picture
    if (!layout || layout.w !== innerWidth) return !doc.querySelector('a.project-card');
    const r = layout.rects[name];
    if (!r) return false;
    const top = traverse ? (history.state?.scrollY ?? 0) : 0;
    const w = Math.min(r[0] + r[2], innerWidth) - Math.max(r[0], 0);
    const h = Math.min(r[1] + r[3], top + innerHeight) - Math.max(r[1], top);
    return w > 0 && h > 0 && (w * h) / (r[2] * r[3]) >= 0.2;
  };
  let navGen = 0;

  // a section back link that points at the page we just came from goes back in
  // history instead: the grid returns at the scroll position it was left at,
  // so the project's picture morphs straight back into its own card
  const STACK_KEY = 'nav-stack';
  // entries are tagged with this document, so a stack left over from an
  // earlier visit (after a full reload or leaving the site) is never trusted
  const DOC_ID = Math.random().toString(36).slice(2);
  const readStack = () => { try { return JSON.parse(sessionStorage.getItem(STACK_KEY) || '{}'); } catch (err) { return {}; } };
  const previousPath = () => {
    const nav = window.navigation;
    if (nav?.entries && nav.currentEntry) {
      const prev = nav.entries()[nav.currentEntry.index - 1];
      return prev?.sameDocument ? new URL(prev.url).pathname : null;
    }
    const idx = history.state?.index;
    const prev = idx > 0 ? readStack()[idx - 1] : null;
    return prev && prev.d === DOC_ID ? prev.p : null;
  };
  let backPending = false;
  // the second click of a double-click / double-tap on a back link comes up to
  // ~500ms after the first — by then the grid is usually back (on iOS nothing
  // covers it) and the click would open whatever card now sits under it: any
  // click that soon after a back link is dropped
  const BACK_GUARD_MS = 500;
  let backQuietUntil = 0;
  document.addEventListener('astro:page-load', () => {
    // a history step that landed late still gets the whole window from arrival
    if (backPending) backQuietUntil = Math.max(backQuietUntil, performance.now() + BACK_GUARD_MS);
    backPending = false;
    const idx = history.state?.index;
    if (idx == null) return;
    const stack = readStack();
    stack[idx] = { p: location.pathname, d: DOC_ID };
    try { sessionStorage.setItem(STACK_KEY, JSON.stringify(stack)); } catch (err) { /* private mode */ }
  });
  addEventListener('pageshow', () => { backPending = false; });
  document.addEventListener('click', (e) => {
    if (performance.now() < backQuietUntil) { e.preventDefault(); e.stopPropagation(); return; }
    const a = e.target.closest?.('a.back-bottom, a.backlink');
    if (!a || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    // a second click before the first one's history step lands would go back twice
    if (backPending) { e.preventDefault(); return; }
    // (also covers a back link that is a plain navigation)
    backQuietUntil = performance.now() + BACK_GUARD_MS;
    let target;
    try { target = new URL(a.href, location.href); } catch (err) { return; }
    if (target.origin === location.origin && previousPath() === target.pathname) {
      e.preventDefault();
      history.back();
    }
    // a history step or a plain navigation: either way the page it lands on
    // gets the whole window from its arrival, however slow the network
    backPending = true;
  }, true);

  // the frame a playing card shows at the click, as an image the next page's
  // film player can sit on — so the card morphs into exactly what it showed
  let frameUrl = '';
  const snapshotFrame = (video) => new Promise((res) => {
    try {
      const w = Math.min(video.videoWidth, 1280);
      const c = document.createElement('canvas');
      c.width = w; c.height = Math.round(video.videoHeight * (w / video.videoWidth));
      c.getContext('2d').drawImage(video, 0, 0, c.width, c.height);
      c.toBlob((b) => res(b ? URL.createObjectURL(b) : ''), 'image/jpeg', 0.9);
    } catch (err) { res(''); }
  });

  document.addEventListener('astro:before-preparation', (e) => {
    const load = e.loader;
    e.loader = async () => {
      // reuse the page the hover/touch warm-up already fetched (same checks as
      // Astro's own loader); otherwise let the router fetch it
      const w = !e.formData && warmed.get(e.to.pathname);
      const html = w ? await w.html : '';
      const warmDoc = html ? parsePage(html) : null;
      if (warmDoc && warmDoc.querySelector('[name="astro-view-transitions-enabled"]')) e.newDocument = warmDoc;
      else await load();
      // superseded while loading: the page on screen is someone else's now
      if (e.signal?.aborted) return;
      const doc = e.newDocument;
      if (!doc || doc === document) return;
      dedupePersist(doc);
      restoreNames();
      navGen++;
      const incoming = coverNamesIn(doc);
      const covers = namedCovers(document);
      // e.from, not location: on a history traverse the URL has already changed
      saveLayout(e.from.pathname, covers);
      const traverse = e.navigationType === 'traverse';
      // grid to grid never morphs: a card that moves far leaves pale holes in
      // both snapshots, and one that stays put looks the same in a cross-fade
      const gridToGrid = !!document.querySelector('a.project-card') && !!doc.querySelector('a.project-card');
      keptNames = new Set();
      covers.forEach(([el, name]) => {
        if (!gridToGrid && incoming.has(name) && inView(el) && willBeInView(doc, e.to.pathname, name, traverse)) keptNames.add(name);
        else suppressName(el);
      });
      // a newer deploy is live: hand this navigation to the browser so the
      // tab picks up fresh JavaScript instead of soft-swapping forever
      const cur = document.querySelector('meta[name="pfs-build"]')?.content;
      const next = doc.querySelector('meta[name="pfs-build"]')?.content;
      if (cur && next && cur !== next) {
        window.location.href = e.to.href;
        return new Promise(() => {});
      }
      const holder = newHolder();
      const jobs = imageryJobs(doc, holder, IMAGERY_LIMIT);
      const player = doc.querySelector('main .player[style*="url("]');
      const card = document.querySelector(`a.project-card[href="${e.to.pathname}"] video`);
      if (player && card && card.readyState >= 2 && card.videoWidth && !card.paused) {
        if (frameUrl) URL.revokeObjectURL(frameUrl);
        frameUrl = await snapshotFrame(card);
        if (frameUrl) {
          player.setAttribute('style', player.getAttribute('style').replace(/url\([^)]*\)/, `url('${frameUrl}')`));
          const im = new Image(); im.src = frameUrl; jobs.push(im.decode().catch(() => {}));
        }
      }
      const pending = warmed.get(e.to.pathname)?.ready;
      if (pending) jobs.push(pending);
      await Promise.race([Promise.all(jobs), new Promise((r) => setTimeout(r, HOLD_MS))]);
      setTimeout(() => holder.remove(), 4000);
    };
  });

  // astro:after-swap fires only on client-side navigations, synchronously
  // BEFORE the browser paints the new page — so the entrance-animation
  // suppression is in place from the first frame (no flash).
  // reveal the new page in ONE piece: keep the dissolve overlay up briefly
  // (cap 200ms) for visible videos' first frames — loops persisted from the
  // previous page are already playing, the rest show their posters
  const revealWhenReady = (shot) => {
    const vids = Array.from(document.querySelectorAll('video[data-src]'))
      .filter((v) => v.getBoundingClientRect().top < window.innerHeight * 1.2)
      .slice(0, 6);
    const jobs = vids.map((v) => new Promise((res) => {
      if (!v.src) { v.src = v.dataset.src; v.load(); }
      v.play().catch(() => {});
      if (v.readyState >= 2) return res();
      v.addEventListener('loadeddata', res, { once: true });
      v.addEventListener('error', res, { once: true });
    }));
    Promise.race([Promise.all(jobs), new Promise((r) => setTimeout(r, 200))]).then(() => {
      requestAnimationFrame(() => requestAnimationFrame(() => {
        shot.style.transition = 'opacity 300ms ease';
        shot.style.opacity = '0';
        setTimeout(() => shot.remove(), 380);
      }));
    });
  };

  // Astro's swap strips html.soft-nav from the root, and a back/forward scroll
  // restore flushes style before after-swap re-adds it — the grid cards then
  // computed their hidden entrance state and replayed the 0.55s fade. Put the
  // class on the incoming root so it is there from the swap itself.
  document.addEventListener('astro:before-swap', (e) => {
    e.newDocument.documentElement.classList.add('soft-nav');
    const gen = navGen;
    e.viewTransition?.finished.finally(() => requestAnimationFrame(() => requestAnimationFrame(() => {
      if (gen === navGen) restoreNames();
    })));
  });
  document.addEventListener('astro:after-swap', () => {
    if (!keptNames) return;
    namedCovers(document).forEach(([el, name]) => {
      if (!(keptNames.has(name) && inView(el))) suppressName(el);
    });
    keptNames = null;
  });

  document.addEventListener('astro:after-swap', () => {
    if (dissolveShot) {
      const shot = dissolveShot;
      dissolveShot = null;
      document.body.appendChild(shot);
      revealWhenReady(shot);
    }
    document.documentElement.classList.add('soft-nav');
    initCoverFades(); // pre-paint: loading imagery must be invisible from frame 1
  });
  // imagery still fetching fades in over a quiet plate instead of popping
  function initCoverFades() {
    document.querySelectorAll('.cover img, .strip-img img').forEach((img) => {
      if (img.complete) return;
      img.setAttribute('data-loading', '');
      const done = () => img.removeAttribute('data-loading');
      img.addEventListener('load', done, { once: true });
      img.addEventListener('error', done, { once: true });
    });
  }

  document.addEventListener('astro:page-load', () => {
    initLoader(); initVideos(); initCoverFades();
  });
</script>
