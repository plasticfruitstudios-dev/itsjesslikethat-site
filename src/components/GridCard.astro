---
// One art-directed project card. Layout values (width/margins) come verbatim
// from the grid data file; title/sub fall back to the project entry.
// The cover carries a view-transition name so it morphs into the project
// page's hero on navigation.
import { Picture } from 'astro:assets';
import { imageFor } from '../lib/images';

interface Props {
  card: {
    slug: string; style?: string;
    media: { type: 'image' | 'video'; src: string; poster?: string; alt?: string; loading?: 'eager' | 'lazy' };
    titleOverride?: string; subOverride?: string;
  };
  project?: { title: string; subtitle?: string };
  reveal?: boolean;
}
const { card, project, reveal = false } = Astro.props;
const title = card.titleOverride ?? project?.title ?? card.slug;
const sub = card.subOverride ?? project?.subtitle;
const m = card.media;
const meta = m.type === 'image' ? imageFor(m.src) : null;
const pMeta = m.type === 'video' && m.poster ? imageFor(m.poster) : null;
const widths = meta ? [...new Set([480, 800, 1400, meta.width].filter((w) => w <= meta.width))] : [];
---
<a class={reveal ? 'project-card reveal' : 'project-card'} href={'/' + card.slug} style={card.style}>
  <div class="cover" transition:name={'cover-' + card.slug}>
    {m.type === 'image'
      ? (meta
          ? <Picture src={meta} formats={['avif', 'webp']} widths={widths} sizes="(max-width: 640px) 92vw, 55vw" loading={m.loading ?? 'lazy'} alt={m.alt ?? title} />
          : <img src={'/' + m.src} loading={m.loading ?? 'lazy'} alt={m.alt ?? title} />)
      : <video data-src={'/' + m.src} poster={m.poster ? '/' + m.poster : undefined} style={pMeta ? `aspect-ratio: ${pMeta.width} / ${pMeta.height}` : undefined} aria-label={m.alt} loop muted playsinline preload="none"></video>}
  </div>
  <div class="card-text"><div class="card-title">{title}</div>{sub && <div class="card-sub">{sub}</div>}</div>
</a>
